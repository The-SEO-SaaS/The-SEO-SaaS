# =============================================================================
# TheSEOSaaS — environment
#
# Copy to `apps/web/.env` and fill in. Every key without a default is REQUIRED;
# the app validates on boot (packages/env/src/server.ts) and refuses to start
# if one is missing.
# =============================================================================

# --- Core --------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
CORS_ORIGIN=http://localhost:3001

# >>> ACTION REQUIRED (new)
# Public origin of the app. Must exactly match the origin Google redirects to,
# and is used to build magic-link and email URLs. No trailing slash.
APP_URL=http://localhost:3001


# --- Auth: Google OAuth ------------------------------------------------------
# There are NO passwords in this app. Sign-in is Google OAuth or email magic
# link. Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials
#
# Authorised redirect URI must be exactly:
#   http://localhost:3001/api/auth/google/callback     (local)
#   https://theseosaas.com/api/auth/google/callback    (production)
#
# >>> ACTION REQUIRED (new)
GOOGLE_CLIENT_ID=
# >>> ACTION REQUIRED (new)
GOOGLE_CLIENT_SECRET=


# --- Email: SMTP via nodemailer ----------------------------------------------
# Plain SMTP, no provider SDK — any host works (Postmark, Mailgun, SES,
# Fastmail...). Port 465 uses implicit TLS; 587 upgrades via STARTTLS.
#
# >>> ACTION REQUIRED (new)
SMTP_HOST=
SMTP_PORT=587
# >>> ACTION REQUIRED (new)
SMTP_USER=
# >>> ACTION REQUIRED (new)
SMTP_PASSWORD=
# >>> ACTION REQUIRED (new)
# Must be a domain you've verified with your SMTP provider, or magic-link
# emails will land in spam.
MAIL_FROM="TheSEOSaaS <hello@theseosaas.com>"


# --- Search: Serpex ----------------------------------------------------------
# https://app.serpex.dev/dashboard/api-keys
#
# >>> ACTION REQUIRED (new)
SERPEX_API_KEY=


# --- AI: OpenRouter ----------------------------------------------------------
# https://openrouter.ai/keys
#
# >>> ACTION REQUIRED (new)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini


# --- Payments: Dodo ----------------------------------------------------------
# Optional until billing is wired up — the app boots without these.
#
# >>> ACTION REQUIRED (new)
DODO_API_KEY=
# >>> ACTION REQUIRED (new)
# Signing secret for the webhook endpoint (apps/web/src/app/api/webhooks/dodo).
# Dodo dashboard -> Webhooks -> your endpoint -> Signing secret. Starts with
# `whsec_`.
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test_mode

# Six products: one per plan (Starter/Growth/Scale) x billing interval
# (monthly/yearly). Create all six in the Dodo dashboard -> Products, using the
# same DODO_ENVIRONMENT mode (test vs live) as the key above.
#
# >>> ACTION REQUIRED (new)
DODO_PRODUCT_STARTER_MONTHLY=
# >>> ACTION REQUIRED (new)
DODO_PRODUCT_STARTER_YEARLY=
# >>> ACTION REQUIRED (new)
DODO_PRODUCT_GROWTH_MONTHLY=
# >>> ACTION REQUIRED (new)
DODO_PRODUCT_GROWTH_YEARLY=
# >>> ACTION REQUIRED (new)
DODO_PRODUCT_SCALE_MONTHLY=
# >>> ACTION REQUIRED (new)
DODO_PRODUCT_SCALE_YEARLY=
