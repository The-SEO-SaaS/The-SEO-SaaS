// ---------------------------------------------------------------------------
// Billing — Dodo Payments. Every plan has every feature; plans differ only by
// limits, so entitlements are numeric quotas rather than feature flags.
// ---------------------------------------------------------------------------

enum Plan {
  STARTER
  GROWTH
  SCALE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
  INCOMPLETE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan     Plan
  interval BillingInterval    @default(MONTHLY)
  status   SubscriptionStatus @default(INCOMPLETE)

  dodoCustomerId     String?
  dodoSubscriptionId String? @unique
  /// Which of the six Dodo products this subscription is on. Kept so a plan
  /// or interval change can be detected from a webhook payload alone.
  dodoProductId      String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum UsageMetric {
  AUDIT
  AI_BLOG_POST
  AI_RECOMMENDATION
}

/// One row per user / metric / billing period. Incremented atomically before
/// a paid action runs, so a quota can never be exceeded by concurrent requests.
model UsageRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  metric      UsageMetric
  amount      Int         @default(0)
  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, metric, periodStart])
  @@index([userId, periodStart])
}

/// Idempotency guard for Dodo webhooks.
///
/// Dodo retries up to 8 times with backoff and states that events may arrive
/// out of order, so a replayed delivery must be a no-op. The unique constraint
/// on (provider, eventId) is what enforces that — the insert fails rather than
/// the handler running twice.
model WebhookEvent {
  id       String @id @default(cuid())
  provider String
  /// The `webhook-id` header, which Dodo guarantees unique per event.
  eventId  String
  type     String
  payload  Json

  processedAt DateTime?
  /// Set when handling threw. Lets us find and replay genuine failures without
  /// re-running events that already succeeded.
  failedAt  DateTime?
  lastError String?

  createdAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([type, createdAt])
}
