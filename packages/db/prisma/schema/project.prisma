// ---------------------------------------------------------------------------
// Project — a single SaaS domain the user is growing. Plan limits are counted
// against this (1 / 3 / 10 projects for Starter / Growth / Scale).
// ---------------------------------------------------------------------------

enum SiteType {
  SAAS
  ECOMMERCE
  CONTENT
  LOCAL
}

enum SitePlatform {
  SHOPIFY
  WORDPRESS
  WEBFLOW
  NEXTJS
  OTHER
}

model Project {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String
  /// Normalised bare host, e.g. "acme.com" — never a full URL.
  domain String

  /// Captured during onboarding. Steers the tone and structure of generated
  /// content — a SaaS feature page and an ecommerce collection page are not
  /// the same brief.
  siteType SiteType?
  /// Only affects export-format hints on drafts; markdown works everywhere.
  platform SitePlatform?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audits        Audit[]
  competitors   Competitor[]
  keywords      Keyword[]
  contentItems  Content[]
  opportunities Opportunity[]

  @@unique([userId, domain])
  @@index([userId])
}

model Competitor {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  domain String
  name   String?
  /// Consultant-voice line: why this competitor matters to the user.
  notes  String?

  discoveredAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pages CompetitorPage[]

  @@unique([projectId, domain])
  @@index([projectId])
}

enum CompetitorPageType {
  BLOG_POST
  FEATURE_PAGE
  LANDING_PAGE
  COMPARISON_PAGE
  INTEGRATION_PAGE
  OTHER
}

model CompetitorPage {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  url   String
  title String
  type  CompetitorPageType @default(BLOG_POST)

  /// Required by the UX spec: never show a page without explaining why it matters.
  whyItMatters String?

  discoveredAt DateTime @default(now())

  @@unique([competitorId, url])
  @@index([competitorId])
}

enum KeywordIntent {
  TRANSACTIONAL
  COMMERCIAL
  INFORMATIONAL
  NAVIGATIONAL
}

enum KeywordSource {
  AUDIT
  MANUAL
  COMPETITOR
}

model Keyword {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  term      String
  intent    KeywordIntent @default(COMMERCIAL)
  source    KeywordSource @default(AUDIT)
  /// Counts against the plan's tracked-keyword limit only when true.
  isTracked Boolean       @default(false)

  /// Consultant-voice rationale, e.g. "buyers comparing tools search this".
  rationale String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rankings KeywordRanking[]

  @@unique([projectId, term])
  @@index([projectId, isTracked])
}

model KeywordRanking {
  id        String  @id @default(cuid())
  keywordId String
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  /// Null means "not found in the tracked result window".
  position  Int?
  url       String?
  checkedAt DateTime @default(now())

  @@index([keywordId, checkedAt])
}
